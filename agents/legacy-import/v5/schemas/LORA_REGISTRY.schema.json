{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://cle-engine.local/schemas/v6/lora-registry.schema.json",
    "title":  "V6 LoRA Registry",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "version",
                     "loras"
                 ],
    "properties":  {
                       "version":  {
                                       "type":  "string",
                                       "pattern":  "^v[0-9]+(\\.[0-9]+)*$"
                                   },
                       "loras":  {
                                     "type":  "array",
                                     "items":  {
                                                   "type":  "object",
                                                   "additionalProperties":  false,
                                                   "required":  [
                                                                    "loraId",
                                                                    "name",
                                                                    "path",
                                                                    "source",
                                                                    "status"
                                                                ],
                                                   "properties":  {
                                                                      "loraId":  {
                                                                                     "type":  "string",
                                                                                     "pattern":  "^[a-z0-9_\\-]{2,64}$"
                                                                                 },
                                                                      "name":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  2,
                                                                                   "maxLength":  120
                                                                               },
                                                                      "path":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  3,
                                                                                   "maxLength":  500
                                                                               },
                                                                      "source":  {
                                                                                     "type":  "string",
                                                                                     "enum":  [
                                                                                                  "v6",
                                                                                                  "v5-import",
                                                                                                  "legacy-import"
                                                                                              ]
                                                                                 },
                                                                      "status":  {
                                                                                     "type":  "string",
                                                                                     "enum":  [
                                                                                                  "active",
                                                                                                  "legacy",
                                                                                                  "planned"
                                                                                              ]
                                                                                 }
                                                                  }
                                               }
                                 }
                   },
    "description":  "Full LoRA registry imported from heritage pipeline."
}
