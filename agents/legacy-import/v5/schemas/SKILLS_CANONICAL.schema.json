{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://cle-engine.local/schemas/v6/skills-canonical.schema.json",
    "title":  "V6 Canonical Skills Registry",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "version",
                     "generatedAt",
                     "generatedFrom",
                     "counts",
                     "skills"
                 ],
    "properties":  {
                       "version":  {
                                       "type":  "string"
                                   },
                       "generatedAt":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       },
                       "generatedFrom":  {
                                             "type":  "array",
                                             "items":  {
                                                           "type":  "string"
                                                       }
                                         },
                       "counts":  {
                                      "type":  "object",
                                      "required":  [
                                                       "total",
                                                       "core_skill",
                                                       "next_skill"
                                                   ],
                                      "additionalProperties":  false,
                                      "properties":  {
                                                         "total":  {
                                                                       "type":  "integer",
                                                                       "minimum":  1
                                                                   },
                                                         "core_skill":  {
                                                                            "type":  "integer",
                                                                            "minimum":  0
                                                                        },
                                                         "next_skill":  {
                                                                            "type":  "integer",
                                                                            "minimum":  0
                                                                        }
                                                     }
                                  },
                       "skills":  {
                                      "type":  "array",
                                      "items":  {
                                                    "type":  "object",
                                                    "additionalProperties":  false,
                                                    "required":  [
                                                                     "skillId",
                                                                     "name",
                                                                     "kind",
                                                                     "status",
                                                                     "source",
                                                                     "path",
                                                                     "summary",
                                                                     "agentCallable",
                                                                     "aliases"
                                                                 ],
                                                    "properties":  {
                                                                       "skillId":  {
                                                                                       "type":  "string",
                                                                                       "pattern":  "^[a-z0-9\\-]{2,80}$"
                                                                                   },
                                                                       "name":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  2
                                                                                },
                                                                       "kind":  {
                                                                                    "type":  "string",
                                                                                    "enum":  [
                                                                                                 "core_skill",
                                                                                                 "next_skill"
                                                                                             ]
                                                                                },
                                                                       "status":  {
                                                                                      "type":  "string",
                                                                                      "enum":  [
                                                                                                   "active",
                                                                                                   "legacy",
                                                                                                   "planned"
                                                                                               ]
                                                                                  },
                                                                       "source":  {
                                                                                      "type":  "string",
                                                                                      "minLength":  3
                                                                                  },
                                                                       "path":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  3,
                                                                                    "maxLength":  500
                                                                                },
                                                                       "summary":  {
                                                                                       "type":  "string",
                                                                                       "minLength":  2,
                                                                                       "maxLength":  500
                                                                                   },
                                                                       "agentCallable":  {
                                                                                             "type":  "boolean"
                                                                                         },
                                                                       "aliases":  {
                                                                                       "type":  "array",
                                                                                       "minItems":  1,
                                                                                       "items":  {
                                                                                                     "type":  "string",
                                                                                                     "minLength":  1
                                                                                                 }
                                                                                   }
                                                                   }
                                                }
                                  }
                   },
    "description":  "Blessed canonical skill definitions for V6 runtime registry."
}
