      "grid_gap": "1.5rem"
    }
  },
  
  "borders": {
    "radius": {
      "none": "0",
      "sm": "0.125rem",
      "base": "0.25rem",
      "md": "0.375rem",
      "lg": "0.5rem",
      "xl": "0.75rem",
      "2xl": "1rem",
      "full": "9999px"
    },
    "width": {
      "0": "0",
      "1": "1px",
      "2": "2px",
      "4": "4px"
    },
    "style": {
      "solid": "solid",
      "dashed": "dashed",
      "dotted": "dotted"
    }
  },
  
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
    "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
    "inner": "inset 0 2px 4px 0 rgba(0, 0, 0, 0.06)"
  },
  
  "components": {
    "button": {
      "variants": {
        "primary": {
          "background": "color_palette.primary.main",
          "color": "color_palette.primary.contrast",
          "hover_background": "color_palette.primary.dark",
          "border_radius": "borders.radius.md",
          "padding": "spacing.component_spacing.button_padding_y spacing.component_spacing.button_padding_x",
          "font_weight": "typography.font_weights.semibold",
          "shadow": "shadows.sm"
        },
        "secondary": {
          "background": "transparent",
          "color": "color_palette.primary.main",
          "border": "borders.width.2 borders.style.solid color_palette.primary.main",
          "hover_background": "color_palette.neutral.50",
          "border_radius": "borders.radius.md",
          "padding": "spacing.component_spacing.button_padding_y spacing.component_spacing.button_padding_x"
        },
        "ghost": {
          "background": "transparent",
          "color": "color_palette.neutral.700",
          "hover_background": "color_palette.neutral.100",
          "border_radius": "borders.radius.md",
          "padding": "spacing.component_spacing.button_padding_y spacing.component_spacing.button_padding_x"
        }
      },
      "states": {
        "disabled": {
          "opacity": 0.5,
          "cursor": "not-allowed"
        },
        "loading": {
          "cursor": "wait",
          "opacity": 0.7
        }
      }
    },
    "card": {
      "background": "color_palette.neutral.50",
      "border": "borders.width.1 borders.style.solid color_palette.neutral.200",
      "border_radius": "borders.radius.lg",
      "padding": "spacing.component_spacing.card_padding",
      "shadow": "shadows.base",
      "hover_shadow": "shadows.md"
    },
    "input": {
      "background": "#FFFFFF",
      "border": "borders.width.1 borders.style.solid color_palette.neutral.300",
      "border_radius": "borders.radius.md",
      "padding": "spacing.3 spacing.4",
      "focus_border_color": "color_palette.primary.main",
      "focus_ring": "0 0 0 3px rgba(99, 102, 241, 0.1)",
      "error_border_color": "color_palette.accent.error"
    },
    "badge": {
      "variants": {
        "success": {
          "background": "color_palette.accent.success",
          "color": "#FFFFFF"
        },
        "warning": {
          "background": "color_palette.accent.warning",
          "color": "#FFFFFF"
        },
        "error": {
          "background": "color_palette.accent.error",
          "color": "#FFFFFF"
        },
        "info": {
          "background": "color_palette.accent.info",
          "color": "#FFFFFF"
        }
      },
      "border_radius": "borders.radius.full",
      "padding": "spacing.1 spacing.3",
      "font_size": "typography.font_sizes.xs",
      "font_weight": "typography.font_weights.semibold"
    }
  },
  
  "layout": {
    "container_max_width": "1280px",
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },
    "grid": {
      "columns": 12,
      "gap": "spacing.component_spacing.grid_gap"
    }
  },
  
  "animation": {
    "duration": {
      "fast": "150ms",
      "base": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "ease_in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease_out": "cubic-bezier(0, 0, 0.2, 1)",
      "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  
  "platform_specific": {
    "web": {
      "touch_target_min_size": "44px",
      "focus_visible_outline": "2px solid color_palette.primary.main",
      "prefer_reduced_motion": "@media (prefers-reduced-motion: reduce)"
    },
    "macos": {
      "window_background": "color_palette.neutral.50",
      "toolbar_height": "52px",
      "traffic_lights_inset": "20px",
      "max_sheet_stack": 4,
      "modal_rules": [
        "Never stack more than 4 .sheet() modifiers on same view",
        "NSOpenPanel.runModal() must not execute from within sheet's onAppear",
        "Use .fileImporter instead of NSOpenPanel for SwiftUI views"
      ]
    },
    "ios": {
      "safe_area_padding": true,
      "navigation_bar_height": "44px",
      "tab_bar_height": "49px",
      "minimum_touch_target": "44px"
    }
  },
  
  "accessibility": {
    "min_contrast_ratio": 4.5,
    "focus_indicator_required": true,
    "keyboard_navigation": "fully_supported",
    "screen_reader_support": "aria_labels_required",
    "motion_preferences": "respect_prefers_reduced_motion"
  },
  
  "usage_guidelines": {
    "color": [
      "Use primary colors for main actions and brand moments",
      "Maintain 4.5:1 contrast ratio for text accessibility",
      "Use semantic colors consistently (success=green, error=red, etc.)",
      "Test color blindness accessibility with Coblis simulator"
    ],
    "typography": [
      "Use font size scale consistently - no arbitrary values",
      "Maintain line-height of 1.5 for body text readability",
      "Use monospace font for code blocks and technical content",
      "Limit line length to 65-75 characters for optimal reading"
    ],
    "spacing": [
      "Use 8px base unit for all spacing (0.5rem increments)",
      "Maintain consistent padding within component types",
      "Use section_margin (3rem) between major page sections",
      "Avoid random spacing values - stick to scale"
    ],
    "components": [
      "Never modify core component structure without design review",
      "Extend components through variants, not one-offs",
      "Document new component patterns in this file",
      "Test components across all supported platforms"
    ]
  },
  
  "auto_injection": {
    "enabled": true,
    "inject_into": [
      "AURORA hive agents",
      "BOLT (production builder)",
      "All frontend-generating agents"
    ],
    "injection_method": "system_prompt",
    "compressed_format": true,
    "include_sections": [
      "color_palette",
      "typography",
      "spacing",
      "components",
      "platform_specific",
      "usage_guidelines"
    ]
  }
