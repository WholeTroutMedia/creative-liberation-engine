{
  "category": "documentation",
  "description": "Writing docs, READMEs, guides, API documentation",
  "agents": ["SCRIBE"],
  "skills": [
    {
      "id": "generate-readme",
      "name": "Generate README",
      "description": "Create comprehensive README with all sections",
      "complexity": "moderate",
      "input": "Project structure, features, setup requirements",
      "output": "Complete README.md with badges, examples, setup",
      "example": "Generate README for new npm package"
    },
    {
      "id": "api-documentation",
      "name": "API Documentation",
      "description": "Generate OpenAPI/Swagger docs from code",
      "complexity": "moderate",
      "input": "API routes, schemas, examples",
      "output": "OpenAPI 3.0 spec + interactive docs",
      "example": "Document REST API with all endpoints"
    },
    {
      "id": "component-documentation",
      "name": "Component Documentation",
      "description": "Create Storybook stories and prop documentation",
      "complexity": "simple",
      "input": "React/Vue components",
      "output": "Storybook stories + JSDoc comments",
      "example": "Document Button component with all variants"
    },
    {
      "id": "architecture-diagram",
      "name": "Architecture Diagram",
      "description": "Generate Mermaid diagrams from code structure",
      "complexity": "moderate",
      "input": "Codebase structure, relationships",
      "output": "Mermaid diagram code + rendered image",
      "example": "Create system architecture diagram"
    },
    {
      "id": "changelog-generation",
      "name": "Changelog Generation",
      "description": "Generate CHANGELOG from git commits",
      "complexity": "simple",
      "input": "Git history, version tags",
      "output": "CHANGELOG.md following Keep a Changelog format",
      "example": "Generate v2.0.0 changelog from commits"
    },
    {
      "id": "inline-documentation",
      "name": "Inline Documentation",
      "description": "Add JSDoc/TSDoc comments to functions",
      "complexity": "simple",
      "input": "Functions without docs",
      "output": "Functions with complete JSDoc comments",
      "example": "Document all utility functions"
    },
    {
      "id": "migration-guide",
      "name": "Migration Guide",
      "description": "Create guides for breaking changes",
      "complexity": "moderate",
      "input": "Old API, new API, migration steps",
      "output": "Step-by-step migration guide",
      "example": "Create v1 to v2 migration guide"
    },
    {
      "id": "troubleshooting-guide",
      "name": "Troubleshooting Guide",
      "description": "Document common issues and solutions",
      "complexity": "moderate",
      "input": "Known issues, error messages, solutions",
      "output": "Searchable troubleshooting documentation",
      "example": "Document common deployment errors"
    }
  ]
}
