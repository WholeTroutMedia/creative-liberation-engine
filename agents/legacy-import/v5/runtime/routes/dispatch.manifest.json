{
  "version": "v6.0",
  "service": "dispatch",
  "routes": [
    {
      "routeId": "route_dispatch_status",
      "path": "/api/status",
      "method": "GET",
      "owner": "ATHENA",
      "upstreamService": "dispatch",
      "upstreamPath": "/api/status",
      "authPolicy": "internal_only",
      "timeoutMs": 2000,
      "criticality": "tier1",
      "observability": {
        "trace": true,
        "metrics": true,
        "logFields": ["routeId", "statusCode", "latencyMs"]
      },
      "lifecycle": "active"
    },
    {
      "routeId": "route_dispatch_task_create",
      "path": "/api/tasks",
      "method": "POST",
      "owner": "ATHENA",
      "upstreamService": "dispatch",
      "upstreamPath": "/api/tasks",
      "authPolicy": "service_token",
      "timeoutMs": 5000,
      "criticality": "tier0",
      "observability": {
        "trace": true,
        "metrics": true,
        "logFields": ["routeId", "statusCode", "latencyMs", "taskType"]
      },
      "lifecycle": "active"
    },
    {
      "routeId": "route_dispatch_task_claim",
      "path": "/api/tasks/claim",
      "method": "POST",
      "owner": "ATHENA",
      "upstreamService": "dispatch",
      "upstreamPath": "/api/tasks/claim",
      "authPolicy": "service_token",
      "timeoutMs": 5000,
      "criticality": "tier0",
      "observability": {
        "trace": true,
        "metrics": true,
        "logFields": ["routeId", "statusCode", "latencyMs", "agentId"]
      },
      "lifecycle": "active"
    },
    {
      "routeId": "route_dispatch_task_complete",
      "path": "/api/tasks/:taskId/complete",
      "method": "POST",
      "owner": "ATHENA",
      "upstreamService": "dispatch",
      "upstreamPath": "/api/tasks/:taskId/complete",
      "authPolicy": "service_token",
      "timeoutMs": 5000,
      "criticality": "tier0",
      "observability": {
        "trace": true,
        "metrics": true,
        "logFields": ["routeId", "statusCode", "latencyMs", "taskId"]
      },
      "lifecycle": "active"
    },
    {
      "routeId": "route_dispatch_sse",
      "path": "/sse",
      "method": "GET",
      "owner": "ATHENA",
      "upstreamService": "dispatch",
      "upstreamPath": "/sse",
      "authPolicy": "internal_only",
      "timeoutMs": 300000,
      "criticality": "tier1",
      "observability": {
        "trace": false,
        "metrics": true,
        "logFields": ["routeId", "connectionDuration"]
      },
      "lifecycle": "active"
    }
  ]
}
