{
  "version": "v6.0",
  "environment": "local",
  "description": "V6 local workstation composition — maps services to docker-compose.local.yml entries.",
  "generatedFrom": "runtime/routes/*.manifest.json",
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "role": "persistence",
      "ports": { "host": 5434, "container": 5432 },
      "healthCheck": "pg_isready -U cle",
      "volumes": ["v6_postgres_data"]
    },
    "redis": {
      "image": "redis:7-alpine",
      "role": "cache-and-queue",
      "ports": { "host": null, "container": 6379 },
      "healthCheck": "redis-cli ping",
      "volumes": ["v6_redis_data"]
    },
    "chromadb": {
      "image": "chromadb/chroma:latest",
      "role": "vector-store",
      "ports": { "host": 8010, "container": 8000 },
      "volumes": ["v6_chromadb_data"]
    },
    "genkit": {
      "buildContext": "./services/genkit",
      "role": "inference",
      "ports": { "host": 4100, "container": 4000 },
      "routeManifest": "genkit.manifest.json",
      "dependsOn": ["redis", "chromadb"]
    },
    "dispatch": {
      "buildContext": "./services/dispatch",
      "role": "task-queue",
      "ports": { "host": 5150, "container": 5150 },
      "routeManifest": "dispatch.manifest.json",
      "dependsOn": ["postgres", "redis", "genkit"]
    },
    "dispatch-worker": {
      "buildContext": "./services/dispatch",
      "role": "task-executor",
      "ports": null,
      "dependsOn": ["postgres", "redis", "chromadb", "genkit", "dispatch"]
    },
    "pulse": {
      "buildContext": "services/pulse",
      "role": "health-monitoring",
      "ports": { "host": 5160, "container": 5060 },
      "routeManifest": "pulse.manifest.json",
      "dependsOn": ["redis"]
    },
    "memory-api": {
      "buildContext": "services/memory-api",
      "role": "memory-persistence",
      "ports": { "host": 5170, "container": 5070 },
      "routeManifest": "memory-api.manifest.json",
      "dependsOn": ["postgres", "redis", "chromadb"]
    },
    "google-workspace-mesh-bridge": {
      "buildContext": "./services/google-workspace-mesh-bridge",
      "role": "workspace-proxy",
      "ports": { "host": 3090, "container": 3000 },
      "routeManifest": "google-workspace.manifest.json"
    },
    "auth-md-hub": {
      "buildContext": "./services/auth-md-hub",
      "role": "identity-provider",
      "ports": { "host": 3013, "container": 3013 },
      "routeManifest": "auth-md-hub.manifest.json",
      "dependsOn": ["postgres", "redis"]
    },
    "physical-twin": {
      "buildContext": "./services/physical-twin",
      "role": "sensor-gate",
      "ports": { "host": 5109, "container": 5109 },
      "routeManifest": "physical-twin.manifest.json",
      "dependsOn": ["postgres", "redis"]
    },
    "intent-router": {
      "buildContext": "./services/intent-router",
      "role": "intent-resolution",
      "ports": { "host": 5180, "container": 5180 },
      "routeManifest": "intent-router.manifest.json",
      "dependsOn": ["redis", "chromadb"]
    },
    "cle-ai-runtime": {
      "buildContext": "./services/cle-ai-runtime",
      "role": "local-model-runtime",
      "ports": { "host": 5090, "container": 5090 },
      "routeManifest": "cle-ai-runtime.manifest.json",
      "dependsOn": ["redis"]
    },
    "latent-space-engine": {
      "buildContext": "./services/latent-space-engine",
      "role": "latent-space-curator",
      "ports": { "host": 3040, "container": 3040 },
      "routeManifest": "latent-space-engine.manifest.json"
    },
    "reasoning-core": {
      "buildContext": "./services/reasoning-core",
      "role": "chain-of-thought-traces",
      "ports": { "host": 5090, "container": 5090 },
      "routeManifest": "reasoning-core.manifest.json",
      "dependsOn": ["averi-memory-service"]
    },
    "workspace-autonomy": {
      "buildContext": "./services/workspace-autonomy",
      "role": "agent-core-sandboxes",
      "ports": { "host": 5091, "container": 5091 },
      "routeManifest": "workspace-autonomy.manifest.json",
      "dependsOn": ["averi-memory-service"]
    },
    "video-agency": {
      "buildContext": "./services/video-agency",
      "role": "video-telemetry-conductor",
      "ports": { "host": 5103, "container": 5103 },
      "routeManifest": "video-agency.manifest.json"
    }
  },
  "volumes": [
    "v6_postgres_data",
    "v6_redis_data",
    "v6_chromadb_data",
    "v6_dispatch_data"
  ],
  "networks": ["cle-v6"]
}
