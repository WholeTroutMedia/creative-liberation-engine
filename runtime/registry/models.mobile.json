    },
    {
      "intent_domain": "general_inquiry",
      "action": "chat",
      "executor": "local",
      "description": "General conversational parsing, brainstorming."
    },
    {
      "intent_domain": "image_generation",
      "action": "generate_image",
      "executor": "remote",
      "description": "Fal AI or midjourney image renders, creative UI previews."
    }
  ]
