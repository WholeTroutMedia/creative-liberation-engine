{
  "name": "@cle/helix",
  "version": "2.0.3",
  "description": "Multi-Helix Orchestration Layer \u2014 First-class lifecycle governance and thread parallelism",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules"
  },
  "vitest": {
    "environment": "node",
    "globals": true,
    "include": [
      "src/**/*.test.ts"
    ]
  },
  "dependencies": {
    "@genkit-ai/googleai": "^0.9.11",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@cle/agent-spawner": "workspace:*",
    "@cle/orchestrator": "workspace:*",
    "genkit": "^0.9.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^1.6.0"
  }
}
