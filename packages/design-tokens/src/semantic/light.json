{
  "color": {
    "background": {
      "$description": "Light mode surface hierarchy — white luminance axis",
      "void": { "$type": "color", "$value": "#ffffff" },
      "default": { "$type": "color", "$value": "#fafafa" },
      "subtle": { "$type": "color", "$value": "#f5f5f7" },
      "muted": { "$type": "color", "$value": "#ebebf0" },
      "elevated": { "$type": "color", "$value": "#ffffff" },
      "overlay": { "$type": "color", "$value": "rgba(0, 0, 0, 0.45)" },
      "inverse": { "$type": "color", "$value": "#0a0a0f" },
      "glass": { "$type": "color", "$value": "rgba(255, 255, 255, 0.72)" },
      "glass-heavy": { "$type": "color", "$value": "rgba(250, 250, 250, 0.88)" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#0a0a0f" },
      "secondary": { "$type": "color", "$value": "#555566" },
      "tertiary": { "$type": "color", "$value": "#888899" },
      "disabled": { "$type": "color", "$value": "#bbbbcc" },
      "inverse": { "$type": "color", "$value": "#f0f0f5" },
      "brand": { "$type": "color", "$value": "#2563eb" },
      "success": { "$type": "color", "$value": "#15803d" },
      "warning": { "$type": "color", "$value": "#b45309" },
      "danger": { "$type": "color", "$value": "#dc2626" },
      "info": { "$type": "color", "$value": "#2563eb" },
      "code": { "$type": "color", "$value": "#6d28d9" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#e5e5eb" },
      "subtle": { "$type": "color", "$value": "#ebebf0" },
      "muted": { "$type": "color", "$value": "#d5d5dd" },
      "strong": { "$type": "color", "$value": "#bbbbcc" },
      "focus": { "$type": "color", "$value": "#2563eb" },
      "brand": { "$type": "color", "$value": "#7c3aed" },
      "danger": { "$type": "color", "$value": "#dc2626" },
      "success": { "$type": "color", "$value": "#16a34a" }
    },
    "interactive": {
      "primary": {
        "default": { "$type": "color", "$value": "#2563eb" },
        "hover": { "$type": "color", "$value": "#1d4ed8" },
        "active": { "$type": "color", "$value": "#1e3a8a" },
        "disabled": { "$type": "color", "$value": "#bfdbfe" }
      },
      "secondary": {
        "default": { "$type": "color", "$value": "#f5f5f7" },
        "hover": { "$type": "color", "$value": "#ebebf0" },
        "active": { "$type": "color", "$value": "#e0e0e8" }
      },
      "destructive": {
        "default": { "$type": "color", "$value": "#dc2626" },
        "hover": { "$type": "color", "$value": "#b91c1c" },
        "active": { "$type": "color", "$value": "#991b1b" }
      },
      "link": {
        "default": { "$type": "color", "$value": "#2563eb" },
        "hover": { "$type": "color", "$value": "#1d4ed8" },
        "visited": { "$type": "color", "$value": "#6d28d9" }
      }
    },
    "status": {
      "success": {
        "bg": { "$type": "color", "$value": "rgba(22, 163, 74, 0.08)" },
        "border": { "$type": "color", "$value": "rgba(22, 163, 74, 0.20)" },
        "text": { "$type": "color", "$value": "#15803d" },
        "icon": { "$type": "color", "$value": "#16a34a" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "rgba(245, 158, 11, 0.08)" },
        "border": { "$type": "color", "$value": "rgba(245, 158, 11, 0.20)" },
        "text": { "$type": "color", "$value": "#b45309" },
        "icon": { "$type": "color", "$value": "#d97706" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "rgba(220, 38, 38, 0.08)" },
        "border": { "$type": "color", "$value": "rgba(220, 38, 38, 0.20)" },
        "text": { "$type": "color", "$value": "#dc2626" },
        "icon": { "$type": "color", "$value": "#ef4444" }
      },
      "info": {
        "bg": { "$type": "color", "$value": "rgba(37, 99, 235, 0.08)" },
        "border": { "$type": "color", "$value": "rgba(37, 99, 235, 0.20)" },
        "text": { "$type": "color", "$value": "#2563eb" },
        "icon": { "$type": "color", "$value": "#3b82f6" }
      },
      "neutral": {
        "bg": { "$type": "color", "$value": "rgba(85, 85, 102, 0.06)" },
        "border": { "$type": "color", "$value": "rgba(85, 85, 102, 0.12)" },
        "text": { "$type": "color", "$value": "#555566" },
        "icon": { "$type": "color", "$value": "#888899" }
      }
    },
    "accent": {
      "blue": { "$type": "color", "$value": "#2563eb" },
      "violet": { "$type": "color", "$value": "#7c3aed" },
      "indigo": { "$type": "color", "$value": "#4f46e5" },
      "cyan": { "$type": "color", "$value": "#0891b2" },
      "emerald": { "$type": "color", "$value": "#059669" },
      "rose": { "$type": "color", "$value": "#e11d48" },
      "amber": { "$type": "color", "$value": "#d97706" }
    },
    "chart": {
      "1": { "$type": "color", "$value": "#2563eb" },
      "2": { "$type": "color", "$value": "#7c3aed" },
      "3": { "$type": "color", "$value": "#059669" },
      "4": { "$type": "color", "$value": "#d97706" },
      "5": { "$type": "color", "$value": "#dc2626" },
      "6": { "$type": "color", "$value": "#0891b2" },
      "7": { "$type": "color", "$value": "#ea580c" },
      "8": { "$type": "color", "$value": "#c026d3" }
    }
  }
}
