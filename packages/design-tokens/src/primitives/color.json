{
  "color": {
    "$type": "color",

    "base": {
      "$description": "Base color aliases — the bridge from primitives to semantics",
      "neutral": {
        "0": { "$value": "{color.white}", "$type": "color" },
        "50": { "$value": "{color.gray.50}", "$type": "color" },
        "100": { "$value": "{color.gray.100}", "$type": "color" },
        "200": { "$value": "{color.gray.200}", "$type": "color" },
        "300": { "$value": "{color.gray.300}", "$type": "color" },
        "400": { "$value": "{color.gray.400}", "$type": "color" },
        "500": { "$value": "{color.gray.500}", "$type": "color" },
        "600": { "$value": "{color.gray.600}", "$type": "color" },
        "700": { "$value": "{color.gray.700}", "$type": "color" },
        "800": { "$value": "#1f2937", "$type": "color" },
        "900": { "$value": "{color.gray.900}", "$type": "color" },
        "950": { "$value": "#0a0a0f", "$type": "color" }
      },
      "brand": {
        "primary": { "$value": "{color.blue.500}", "$type": "color", "$description": "Primary brand — CLE Blue" },
        "secondary": { "$value": "{color.violet.500}", "$type": "color", "$description": "Secondary brand — Violet" },
        "tertiary": { "$value": "#06b6d4", "$type": "color", "$description": "Tertiary — Cyan accent" }
      },
      "feedback": {
        "success": { "$value": "{color.green.500}", "$type": "color" },
        "warning": { "$value": "{color.amber.500}", "$type": "color" },
        "danger": { "$value": "{color.red.500}", "$type": "color" },
        "info": { "$value": "{color.blue.400}", "$type": "color" }
      }
    },

