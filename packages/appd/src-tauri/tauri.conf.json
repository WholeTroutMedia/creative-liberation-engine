{
  "productName": "Creative Liberation Engine",
  "version": "2.0.3",
  "identifier": "systems.cle.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @cle/dashboard dev",
    "beforeBuildCommand": "pnpm --filter @cle/dashboard build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../apps/dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Creative Liberation Engine // Sovereign Integration Wizard",
        "width": 960,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
