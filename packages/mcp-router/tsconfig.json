{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "lib": ["ES2022", "DOM"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "src/**/*.test.ts",
        "src/__tests__/**"
    ]
}