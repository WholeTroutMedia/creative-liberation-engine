{
  "name": "@cle/agent-mail",
  "version": "2.0.3",
  "private": true,
  "description": "Sovereign agent email service \u2014 Cloudflare Worker with MCP + REST API",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply agent-mail-db",
