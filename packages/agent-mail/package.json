    "@react-email/render": "1.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260310.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
