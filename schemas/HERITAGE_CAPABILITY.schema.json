{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cle-engine.local/schemas/v6/heritage-capability.schema.json",
  "title": "V6 Heritage Capability",
  "description": "Inventory contract for preserving V1-V5 features, workflows, and ideas during V6 migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId",
    "name",
    "originVersion",
    "category",
    "intent",
    "implementationStatus",
    "wiringStatus",
    "classification",
    "owner",
    "evidence",
    "lastReviewedAt"
  ],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^cap_[a-z0-9_\\-]{3,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "originVersion": {
      "type": "string",
      "enum": ["v1", "v2", "v3", "v4", "v5", "multi"]
    },
    "category": {
      "type": "string",
      "enum": [
        "agent",
        "workflow",
        "service",
        "package",
        "memory",
        "routing",
        "ui_surface",
        "infrastructure",
        "governance",
        "other"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["concept", "partial", "implemented", "deprecated", "unknown"]
    },
    "wiringStatus": {
      "type": "string",
      "enum": ["wired", "unwired", "partially_wired", "broken", "unknown"]
    },
    "classification": {
      "type": "string",
      "enum": ["PROMOTE", "PARK", "MERGE", "RETIRE"]
    },
    "classificationRationale": {
      "type": "string",
      "maxLength": 2000
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "default": []
    },
    "replacementTarget": {
      "type": "string",
      "maxLength": 200
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "doc", "commit", "session", "memory", "other"]
          },
          "ref": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "riskIfLost": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "lastReviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
