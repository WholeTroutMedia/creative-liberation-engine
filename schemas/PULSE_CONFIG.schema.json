{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cle.engine/schemas/PULSE_CONFIG.schema.json",
  "title": "PULSE Configuration Schema",
  "description": "Configuration schema for the PULSE Biometric Vision service.",
  "type": "object",
  "required": ["service", "capture", "face_detection", "rppg", "signals", "osc", "midi", "websocket", "sse", "dashboard"],
  "properties": {
    "service": {
      "type": "object",
      "required": ["name", "version", "log_level"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "log_level": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] }
      }
    },
    "capture": {
      "type": "object",
      "required": ["source", "width", "height", "fps", "buffer_seconds"],
      "properties": {
        "source": { "type": "string", "enum": ["webcam", "rtsp", "file"] },
        "device_index": { "type": "integer" },
        "rtsp_url": { "type": "string" },
        "file_path": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" },
        "buffer_seconds": { "type": "integer" }
      }
    },
    "face_detection": {
      "type": "object",
      "properties": {
        "min_detection_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_tracking_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "roi_strategy": { "type": "string", "enum": ["forehead", "cheeks", "full_face", "multi_roi"] },
        "refine_landmarks": { "type": "boolean" }
      }
    },
    "rppg": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "enum": ["chrom", "pos", "ica", "green", "efficientphys", "physnet"] },
        "fallback_method": { "type": "string" },
        "bandpass_low": { "type": "number" },
        "bandpass_high": { "type": "number" },
        "welch_window_seconds": { "type": "integer" },
        "update_interval_seconds": { "type": "number" }
      }
    },
    "signals": {
      "type": "object",
      "properties": {
        "heart_rate": { "type": "boolean" },
        "hrv": { "type": "boolean" },
        "respiratory_rate": { "type": "boolean" },
        "stress_index": { "type": "boolean" },
        "raw_bvp": { "type": "boolean" }
      }
    },
    "osc": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "addresses": { "type": "object" }
      }
    },
    "midi": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port_name": { "type": "string" },
        "channel": { "type": "integer" },
        "cc_mappings": { "type": "object" }
      }
    },
    "websocket": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "broadcast_interval_ms": { "type": "integer" }
      }
    },
    "sse": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "event_type": { "type": "string" }
      }
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "static_dir": { "type": "string" }
      }
    },
    "dispatch": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "format": "uri" },
        "alerts": { "type": "object" }
      }
    }
  }
}
