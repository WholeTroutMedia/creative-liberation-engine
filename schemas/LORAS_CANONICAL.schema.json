{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://cle-engine.local/schemas/v6/loras-canonical.schema.json",
    "title":  "V6 Canonical LoRA Registry",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "version",
                     "generatedAt",
                     "generatedFrom",
                     "counts",
                     "loras"
                 ],
    "properties":  {
                       "version":  {
                                       "type":  "string"
                                   },
                       "generatedAt":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       },
                       "generatedFrom":  {
                                             "type":  "array",
                                             "items":  {
                                                           "type":  "string"
                                                       }
                                         },
                       "counts":  {
                                      "type":  "object",
                                      "required":  [
                                                       "total",
                                                       "enhancement_lora",
                                                       "runtime_lora",
                                                       "adapter",
                                                       "legacy_artifact"
                                                   ],
                                      "additionalProperties":  false,
                                      "properties":  {
                                                         "total":  {
                                                                       "type":  "integer",
                                                                       "minimum":  1
                                                                   },
                                                         "enhancement_lora":  {
                                                                                  "type":  "integer",
                                                                                  "minimum":  0
                                                                              },
                                                         "runtime_lora":  {
                                                                              "type":  "integer",
                                                                              "minimum":  0
                                                                          },
                                                         "adapter":  {
                                                                         "type":  "integer",
                                                                         "minimum":  0
                                                                     },
                                                         "legacy_artifact":  {
                                                                                 "type":  "integer",
                                                                                 "minimum":  0
                                                                             }
                                                     }
                                  },
                       "loras":  {
                                     "type":  "array",
                                     "items":  {
                                                   "type":  "object",
                                                   "additionalProperties":  false,
                                                   "required":  [
                                                                    "loraId",
                                                                    "name",
                                                                    "kind",
                                                                    "status",
                                                                    "source",
                                                                    "path",
                                                                    "aliases"
                                                                ],
                                                   "properties":  {
                                                                      "loraId":  {
                                                                                     "type":  "string",
                                                                                     "pattern":  "^[a-z0-9\\-]{2,120}$"
                                                                                 },
                                                                      "name":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  2
                                                                               },
                                                                      "kind":  {
                                                                                   "type":  "string",
                                                                                   "enum":  [
                                                                                                "enhancement_lora",
                                                                                                "runtime_lora",
                                                                                                "adapter",
                                                                                                "legacy_artifact"
                                                                                            ]
                                                                               },
                                                                      "status":  {
                                                                                     "type":  "string",
                                                                                     "enum":  [
                                                                                                  "active",
                                                                                                  "legacy",
                                                                                                  "planned"
                                                                                              ]
                                                                                 },
                                                                      "source":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  2
                                                                                 },
                                                                      "path":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  3,
                                                                                   "maxLength":  500
                                                                               },
                                                                      "aliases":  {
                                                                                      "type":  "array",
                                                                                      "minItems":  1,
                                                                                      "items":  {
                                                                                                    "type":  "string",
                                                                                                    "minLength":  1
                                                                                                }
                                                                                  }
                                                                  }
                                               }
                                 }
                   },
    "description":  "Blessed canonical LoRA definitions for V6 model operations."
}
