{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://cle-engine.local/schemas/v6/workflows-canonical.schema.json",
    "title":  "V6 Canonical Workflows Registry",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "version",
                     "generatedAt",
                     "generatedFrom",
                     "counts",
                     "workflows"
                 ],
    "properties":  {
                       "version":  {
                                       "type":  "string"
                                   },
                       "generatedAt":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       },
                       "generatedFrom":  {
                                             "type":  "array",
                                             "items":  {
                                                           "type":  "string"
                                                       }
                                         },
                       "counts":  {
                                      "type":  "object",
                                      "required":  [
                                                       "total",
                                                       "core_spine",
                                                       "helix",
                                                       "reliability",
                                                       "evaluation",
                                                       "ops"
                                                   ],
                                      "additionalProperties":  false,
                                      "properties":  {
                                                         "total":  {
                                                                       "type":  "integer",
                                                                       "minimum":  1
                                                                   },
                                                         "core_spine":  {
                                                                            "type":  "integer",
                                                                            "minimum":  0
                                                                        },
                                                         "helix":  {
                                                                       "type":  "integer",
                                                                       "minimum":  0
                                                                   },
                                                         "reliability":  {
                                                                             "type":  "integer",
                                                                             "minimum":  0
                                                                         },
                                                         "evaluation":  {
                                                                            "type":  "integer",
                                                                            "minimum":  0
                                                                        },
                                                         "ops":  {
                                                                     "type":  "integer",
                                                                     "minimum":  0
                                                                 }
                                                     }
                                  },
                       "workflows":  {
                                         "type":  "array",
                                         "items":  {
                                                       "type":  "object",
                                                       "additionalProperties":  false,
                                                       "required":  [
                                                                        "workflowId",
                                                                        "name",
                                                                        "kind",
                                                                        "status",
                                                                        "source",
                                                                        "path",
                                                                        "summary",
                                                                        "aliases"
                                                                    ],
                                                       "properties":  {
                                                                          "workflowId":  {
                                                                                             "type":  "string",
                                                                                             "pattern":  "^[a-z0-9\\-]{2,80}$"
                                                                                         },
                                                                          "name":  {
                                                                                       "type":  "string",
                                                                                       "minLength":  2
                                                                                   },
                                                                          "kind":  {
                                                                                       "type":  "string",
                                                                                       "enum":  [
                                                                                                    "core_spine",
                                                                                                    "helix",
                                                                                                    "reliability",
                                                                                                    "evaluation",
                                                                                                    "ops"
                                                                                                ]
                                                                                   },
                                                                          "status":  {
                                                                                         "type":  "string",
                                                                                         "enum":  [
                                                                                                      "active",
                                                                                                      "legacy",
                                                                                                      "planned"
                                                                                                  ]
                                                                                     },
                                                                          "source":  {
                                                                                         "type":  "string",
                                                                                         "minLength":  2
                                                                                     },
                                                                          "path":  {
                                                                                       "type":  "string",
                                                                                       "minLength":  3,
                                                                                       "maxLength":  500
                                                                                   },
                                                                          "summary":  {
                                                                                          "type":  "string",
                                                                                          "minLength":  0,
                                                                                          "maxLength":  500
                                                                                      },
                                                                          "aliases":  {
                                                                                          "type":  "array",
                                                                                          "minItems":  1,
                                                                                          "items":  {
                                                                                                        "type":  "string",
                                                                                                        "minLength":  1
                                                                                                    }
                                                                                      }
                                                                      }
                                                   }
                                     }
                   },
    "description":  "Blessed canonical workflow definitions for V6 runtime registry."
}
