{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cle-engine.local/schemas/v6/sam-agentcore.schema.json",
  "title": "Sovereign AgentCore Mirror (SAM) Schema",
  "description": "Schema validating declarative Bedrock AgentCore configurations for local execution on Forgejo pipelines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agentName",
    "instruction",
    "foundationModel"
  ],
  "properties": {
    "agentName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "instruction": {
      "type": "string",
      "description": "The base system instruction or behavioral guideline for the agent."
    },
    "foundationModel": {
      "type": "string",
      "description": "The LLM model backing the agent execution (e.g. gemini-2.5-flash)."
    },
    "orchestrationType": {
      "type": "string",
      "enum": ["default", "custom_orchestration"],
      "default": "default"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["code_interpreter", "web_browser", "custom_tool"]
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "endpoint": { "type": "string" }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "contentFilters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "strength"],
            "properties": {
              "type": { "type": "string" },
              "strength": { "type": "string", "enum": ["none", "low", "medium", "high"] }
            }
          }
        }
      }
    }
  }
}
