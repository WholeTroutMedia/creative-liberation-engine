{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cleengine.systems/schemas/AGENT_OBSERVABILITY.schema.json",
  "title": "Agent Observability Schema",
  "description": "Defines the structure for real-time agent execution tracing, debugging, and evaluation within the Creative Liberation Engine.",
  "type": "object",
  "required": ["trace_id", "agent_id", "session_id", "started_at", "spans"],
  "properties": {
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this execution trace"
    },
    "agent_id": {
      "type": "string",
      "description": "Canonical agent identifier from agents.canonical.json"
    },
    "session_id": {
      "type": "string",
      "description": "Session or conversation context ID"
    },
    "task_id": {
      "type": "string",
      "description": "Dispatch task ID if applicable"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed", "timeout", "cancelled"]
    },
    "model_used": {
      "type": "string",
      "description": "Model identifier used for this execution"
    },
    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      },
      "required": ["input_tokens", "output_tokens", "total_tokens"]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Total wall-clock time in milliseconds"
    },
    "spans": {
      "type": "array",
      "description": "Ordered list of execution spans within this trace",
      "items": {
        "type": "object",
        "required": ["span_id", "operation", "started_at"],
        "properties": {
          "span_id": { "type": "string" },
          "parent_span_id": { "type": ["string", "null"] },
          "operation": {
            "type": "string",
            "enum": ["tool_call", "llm_inference", "memory_read", "memory_write", "route_dispatch", "skill_invoke", "decision_point", "error_recovery", "human_escalation"]
          },
          "tool_name": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": ["string", "null"], "format": "date-time" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "input_summary": { "type": "string", "maxLength": 500 },
          "output_summary": { "type": "string", "maxLength": 500 },
          "decision_rationale": {
            "type": "string",
            "description": "Why this path was chosen over alternatives"
          },
          "error": {
            "type": ["object", "null"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "recoverable": { "type": "boolean" }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "description": "Post-execution evaluation metrics",
      "properties": {
        "task_success": { "type": "boolean" },
        "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "efficiency_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "hallucination_detected": { "type": "boolean" },
        "constitutional_violations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluator_notes": { "type": "string" }
      }
    },
    "constitutional_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Any constitutional principles relevant to this execution"
    }
  },
  "additionalProperties": false
}
