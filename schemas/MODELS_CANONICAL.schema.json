{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://cle-engine.local/schemas/v6/models-canonical.schema.json",
    "title":  "V6 Canonical Models Registry",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "version",
                     "generatedAt",
                     "generatedFrom",
                     "counts",
                     "modelTiers",
                     "fleetServices"
                 ],
    "properties":  {
                       "version":  {
                                       "type":  "string"
                                   },
                       "generatedAt":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       },
                       "generatedFrom":  {
                                             "type":  "array",
                                             "items":  {
                                                           "type":  "string"
                                                       }
                                         },
                       "counts":  {
                                      "type":  "object",
                                      "required":  [
                                                       "modelTiers",
                                                       "fleetServices"
                                                   ],
                                      "additionalProperties":  false,
                                      "properties":  {
                                                         "modelTiers":  {
                                                                            "type":  "integer",
                                                                            "minimum":  1
                                                                        },
                                                         "fleetServices":  {
                                                                               "type":  "integer",
                                                                               "minimum":  1
                                                                           }
                                                     }
                                  },
                       "modelTiers":  {
                                          "type":  "array",
                                          "items":  {
                                                        "type":  "object",
                                                        "required":  [
                                                                         "tier",
                                                                         "fallbackModel",
                                                                         "locality"
                                                                     ],
                                                        "additionalProperties":  false,
                                                        "properties":  {
                                                                           "tier":  {
                                                                                        "type":  "string",
                                                                                        "minLength":  2
                                                                                    },
                                                                           "fallbackModel":  {
                                                                                                 "type":  "string",
                                                                                                 "minLength":  2
                                                                                             },
                                                                           "locality":  {
                                                                                            "type":  "string",
                                                                                            "enum":  [
                                                                                                         "cloud",
                                                                                                         "cloud-relay",
                                                                                                         "local",
                                                                                                         "web"
                                                                                                     ]
                                                                                        },
                                                                           "notes": {
                                                                               "type": "string"
                                                                           },
                                                                           "contextWindow": {
                                                                               "type": "integer"
                                                                           },
                                                                           "fallbackTier": {
                                                                               "type": "string",
                                                                               "minLength": 2
                                                                           }
                                                                       }
                                                    }
                                      },
                       "fleetServices":  {
                                             "type":  "array",
                                             "items":  {
                                                           "type":  "string",
                                                           "minLength":  2
                                                       }
                                         },
                       "lastSweep": {
                           "type": "string"
                       },
                       "modelStorage": {
                           "type": "object",
                           "additionalProperties": false,
                           "properties": {
                               "workstation": { "$ref": "#/$defs/storageEndpoint" },
                               "nas": { "$ref": "#/$defs/storageEndpoint" }
                           }
                       },
                       "pendingInstalls": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "additionalProperties": false,
                               "required": ["name", "source", "tier"],
                               "properties": {
                                   "name": { "type": "string", "minLength": 1 },
                                   "source": { "type": "string", "minLength": 1 },
                                   "tier": { "type": "string", "minLength": 1 },
                                   "estimatedSizeGB": { "type": "number" },
                                   "license": { "type": "string" },
                                   "priority": { "type": "string" },
                                   "reason": { "type": "string" },
                                   "ideation": { "type": "string" },
                                   "installCommand": { "type": "string" }
                               }
                           }
                       },
                       "installedModels": {
                           "type": "array",
                           "items": {
                               "type": "object",
                               "additionalProperties": false,
                               "required": ["name", "endpoint", "size_gb", "modified"],
                               "properties": {
                                   "name": { "type": "string", "minLength": 1 },
                                   "endpoint": { "type": "string", "minLength": 1 },
                                   "size_gb": { "type": "number" },
                                   "modified": { "type": "string", "minLength": 1 }
                               }
                           }
                       }
                   },
    "$defs": {
        "storageEndpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "notes"],
            "properties": {
                "path": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" }
            }
        }
    },
    "description":  "Blessed canonical model definitions for V6 model arbitrage."
}
