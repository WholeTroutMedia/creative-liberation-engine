{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cle-engine.local/schemas/v6/route-manifest.schema.json",
  "title": "V6 Route Manifest",
  "description": "Manifest of route contracts for a service or gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "service", "routes"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)*$"
    },
    "service": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://cle-engine.local/schemas/v6/route-contract.schema.json"
      }
    }
  }
}
