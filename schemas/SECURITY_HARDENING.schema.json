{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cle-engine.local/schemas/v6/security-hardening.schema.json",
  "title": "V6 Security Hardening Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "helixId",
    "status",
    "controls"
  ],
  "properties": {
    "helixId": {
      "const": "helix-d-security"
    },
    "status": {
      "type": "string",
      "enum": ["declared", "implementing", "validated", "hardened"]
    },
    "statusReason": {
      "type": ["string", "null"]
    },
    "lastValidated": {
      "type": ["string", "null"]
    },
    "validatedBy": {
      "type": ["string", "null"]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiKeyAuth",
        "mtlsGateway",
        "secretsVault",
        "rateLimiting",
        "inputValidation"
      ],
      "properties": {
        "apiKeyAuth": { "$ref": "#/$defs/control" },
        "mtlsGateway": { "$ref": "#/$defs/control" },
        "secretsVault": { "$ref": "#/$defs/control" },
        "rateLimiting": { "$ref": "#/$defs/control" },
        "inputValidation": { "$ref": "#/$defs/control" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "controlId": { "type": "string" },
          "evidenceId": { "type": "string" },
          "timestamp": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["controlId", "evidenceId", "timestamp"]
      }
    },
    "validationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "timestamp": { "type": "string" },
          "justification": { "type": "string" },
          "operator": { "type": "string" }
        },
        "required": ["status", "timestamp"]
      }
    }
  },
  "description": "Security and policy hardening manifest - secrets management, allow/deny boundaries, audit trail emission.",
  "$defs": {
    "control": {
      "oneOf": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "type": "object",
          "properties": {
            "declared": { "type": "boolean" },
            "validated": { "type": "boolean" },
            "lastTestedAt": { "type": ["string", "null"] },
            "testCommand": { "type": ["string", "null"] },
            "notes": { "type": "string" }
          },
          "required": ["declared", "validated"],
          "additionalProperties": false
        }
      ]
    }
  }
}
