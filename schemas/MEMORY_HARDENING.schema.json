{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cle-engine.local/schemas/v6/memory-hardening.schema.json",
  "title": "V6 Memory Hardening Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "helixId",
    "status",
    "controls"
  ],
  "properties": {
    "helixId": {
      "const": "helix-c-memory"
    },
    "status": {
      "type": "string",
      "enum": ["declared", "implementing", "validated", "hardened"]
    },
    "statusReason": {
      "type": ["string", "null"]
    },
    "lastValidated": {
      "type": ["string", "null"]
    },
    "validatedBy": {
      "type": ["string", "null"]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionPersistence",
        "crossSessionKnowledge",
        "checkpointRecovery",
        "auditTrail",
        "tieredStorage"
      ],
      "properties": {
        "sessionPersistence": { "$ref": "#/$defs/control" },
        "crossSessionKnowledge": { "$ref": "#/$defs/control" },
        "checkpointRecovery": { "$ref": "#/$defs/control" },
        "auditTrail": { "$ref": "#/$defs/control" },
        "tieredStorage": { "$ref": "#/$defs/control" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "controlId": { "type": "string" },
          "evidenceId": { "type": "string" },
          "timestamp": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["controlId", "evidenceId", "timestamp"]
      }
    },
    "validationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "timestamp": { "type": "string" },
          "justification": { "type": "string" },
          "operator": { "type": "string" }
        },
        "required": ["status", "timestamp"]
      }
    }
  },
  "description": "Memory plane hardening manifest - session persistence, cross-session knowledge, checkpoint recovery, audit trail, tiered storage.",
  "$defs": {
    "control": {
      "oneOf": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "type": "object",
          "properties": {
            "declared": { "type": "boolean" },
            "validated": { "type": "boolean" },
            "lastTestedAt": { "type": ["string", "null"] },
            "testCommand": { "type": ["string", "null"] },
            "notes": { "type": "string" }
          },
          "required": ["declared", "validated"],
          "additionalProperties": false
        }
      ]
    }
  }
}
