{
  "themeName": "Solar-Paper-Brutalism",
  "tokens": {
    "--color-primary": "#FF4E00",
    "--color-primary-foreground": "#000000",
    "--color-primary-subtle": "rgba(255, 78, 0, 0.1)",
    "--color-accent": "#FF4E00",
    "--color-accent-foreground": "#FFFFFF",
    "--color-accent-subtle": "rgba(255, 78, 0, 0.05)",
    "--color-surface-base": "#FDFBF7",
    "--color-surface-elevated": "#FFFFFF",
    "--color-surface-overlay": "#FDFBF7",
    "--color-surface-glass": "rgba(253, 251, 247, 0.8)",
    "--color-surface-glass-border": "#000000",
    "--color-text-primary": "#000000",
    "--color-text-secondary": "#1C1C1C",
    "--color-text-tertiary": "#555555",
    "--font-heading": "'Space Grotesk', system-ui, -apple-system, sans-serif",
    "--font-body": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
    "--font-mono": "'JetBrains Mono', monospace",
    "--animation-interactive": "all 0.15s cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "designInstructions": [
    "Grid-strict editorial layout with high contrast, sharp margins, and visible 1px borders.",
    "Typography: Space Grotesk for bold, oversized headers (700 wt); Plus Jakarta Sans for high-readability body text.",
    "Aesthetics: Absolute flat design. Do NOT use gradients, soft drop shadows, or glow effects.",
    "Layout: Use asymmetric columns, massive text callouts, and clean data tables."
  ]
}
