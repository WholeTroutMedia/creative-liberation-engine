# Creative Liberation Engine — Environment Template
# Copy to .env for local customization. Never commit real credentials.

CLE_MODE=offline
CLE_PROVIDER=local
CLE_MODEL=local-deterministic
CLE_LOG_LEVEL=INFO

# Optional: Local or remote inference endpoints (only used when CLE_PROVIDER != local)
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=YOUR_API_KEY_HERE
GEMINI_API_KEY=YOUR_API_KEY_HERE
