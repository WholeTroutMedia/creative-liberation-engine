name: inception-v6

networks:
  inception-v6:
    external: true
    name: genesis-deploy_genesis-net

services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-inception_v6}
      POSTGRES_USER: ${POSTGRES_USER:-inception}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      POSTGRES_HOST_AUTH_METHOD: trust
    volumes:
      - /volume2/inception-engine/v6/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-inception}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks: [inception-v6]

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: >
      redis-server --requirepass ${REDIS_PASSWORD:?set REDIS_PASSWORD}
      --appendonly yes --appendfsync everysec --save 900 1 --save 300 10
    volumes:
      - /volume2/inception-engine/v6/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks: [inception-v6]

  chromadb:
    image: chromadb/chroma:latest
    restart: unless-stopped
    environment:
      ANONYMIZED_TELEMETRY: "false"
      ALLOW_RESET: "false"
    volumes:
      - /volume2/inception-engine/v6/chromadb:/chroma/chroma
    networks: [inception-v6]

  genkit:
    image: inception/genkit:genesis
    restart: unless-stopped
    ports:
      - "${GENKIT_HOST_PORT:-4100}:4000"
      - "${GENKIT_UI_HOST_PORT:-3101}:3100"
    environment:
      NODE_ENV: production
      PORT: 4000
      GENKIT_ENV: production
      GENKIT_API_KEY: ${GENKIT_API_KEY:?set GENKIT_API_KEY}
      GENKIT_TRUST_PRIVATE_NETWORK: ${GENKIT_TRUST_PRIVATE_NETWORK:-true}
      GOOGLE_API_KEY: ${GOOGLE_API_KEY:-}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      PERPLEXITY_API_KEY: ${PERPLEXITY_API_KEY:-}
      FAL_API_KEY: ${FAL_API_KEY:-}
      GOOGLE_CLOUD_PROJECT: ${GOOGLE_CLOUD_PROJECT:-inception-engine}

      OLLAMA_HOST: ${OLLAMA_HOST:-http://ollama:11434}
      OLLAMA_URL: ${OLLAMA_URL:-http://ollama:11434}
      CHROMA_URL: http://chromadb:8000
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis:6379

      # Fleet routing hints for higher throughput tiers.
      TRITON_HTTP_URL: ${TRITON_HTTP_URL:-http://triton-server:8000}
      VLLM_OPENAI_URL: ${VLLM_OPENAI_URL:-http://vllm:8000}
      GENKIT_DEFAULT_MODEL: ${GENKIT_DEFAULT_MODEL:-ollama/qwen2.5:3b}
      ACCESS_TIER: ${ACCESS_TIER:-production}
    depends_on:
      redis:
        condition: service_healthy
      chromadb:
        condition: service_started
    networks: [inception-v6]

  dispatch:
    image: inception/dispatch:genesis
    restart: unless-stopped
    ports:
      - "${DISPATCH_HOST_PORT:-5150}:5050"
    environment:
      PORT: 5050
      PROJECT: ${PROJECT:-brainchild-v6}
      WORKER_POLL_MS: ${WORKER_POLL_MS:-2500}
      GENKIT_URL: http://inception-v6-genkit-1:4000
      DISPATCH_URL: http://inception-v6-dispatch-1:5050

      REDIS_URL: redis://:${REDIS_PASSWORD}@redis:6379
      POSTGRES_URL: postgresql://${POSTGRES_USER:-inception}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-inception_v6}
      DISPATCH_STORE_DIR: /data
    volumes:
      - /volume2/inception-engine/v6/dispatch:/data
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      genkit:
        condition: service_started
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:5050/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks: [inception-v6]

  dispatch-worker:
    image: inception/dispatch:genesis
    restart: unless-stopped
    command: node build/worker.js
    environment:
      WORKER_ID: dispatch-worker-v6-nas
      WORKER_CONCURRENCY: ${WORKER_CONCURRENCY:-4}
      WORKER_POLL_MS: ${WORKER_POLL_MS:-2500}
      GENKIT_URL: http://inception-v6-genkit-1:4000
      DISPATCH_URL: http://inception-v6-dispatch-1:5050
      PROJECT: ${PROJECT:-brainchild-v6}
      GENKIT_API_KEY: ${GENKIT_API_KEY}
      REDIS_URL: redis://:${REDIS_PASSWORD}@redis:6379
      POSTGRES_URL: postgresql://${POSTGRES_USER:-inception}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-inception_v6}
      DISPATCH_STORE_DIR: /data
      CHROMA_URL: http://chromadb:8000
      OLLAMA_URL: ${OLLAMA_URL:-http://ollama:11434}
      OLLAMA_HOST: ${OLLAMA_HOST:-http://ollama:11434}
    volumes:
      - /volume2/inception-engine/v6/dispatch:/data
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      chromadb:
        condition: service_started
      genkit:
        condition: service_started
      dispatch:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://inception-v6-genkit-1:4000/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 45s
    networks: [inception-v6]
